@inject Microsoft.Extensions.Localization.IStringLocalizer<Luma.SharedResource> Localizer

@code {
    [CascadingParameter(Name = "UICulture")] private string UICulture { get; set; } = "";
}

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.WbSunny">
        @Localizer["Nav_Home"]
    </MudNavLink>
    <MudNavLink Href="planner" Icon="@Icons.Material.Filled.CalendarMonth">
        @Localizer["Nav_Planner"]
    </MudNavLink>
    <MudNavLink Href="settings" Icon="@Icons.Material.Filled.Settings">
        @Localizer["Nav_Settings"]
    </MudNavLink>
</MudNavMenu>