@page "/"

<MudContainer MaxWidth="MaxWidth.Small" Class="py-6">
    <MudText Typo="Typo.h5" Style="color: #f5a623; font-weight: 700; margin-bottom: 0.5rem;">
        🌅 现在的光线
    </MudText>
    <MudText Typo="Typo.caption" Style="color: #999; margin-bottom: 2rem; display: block;">
        实时光线助手
    </MudText>

    <MudCard Style="background-color: #1a1a1a; border: 1px solid #333; border-radius: 12px;">
        <MudCardContent>
            <MudText Typo="Typo.h4" Align="Align.Center" Style="color: #f5a623;">
                @CurrentPhaseIcon @CurrentPhaseName
            </MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Style="color: #f0f0f0; margin-top: 0.5rem;">
                @CurrentPhaseDescription
            </MudText>
            <MudDivider Style="margin: 1rem 0; border-color: #333;" />
            <MudText Typo="Typo.body2" Style="color: #999;" Align="Align.Center">
                下一个好时段：@NextPhase
            </MudText>
        </MudCardContent>
    </MudCard>
</MudContainer>