@page "/"
@inject Microsoft.Extensions.Localization.IStringLocalizer<Luma.SharedResource> Localizer

<MudContainer MaxWidth="MaxWidth.Small" Class="home-container py-6">

    <MudText Typo="Typo.h5" Class="page-title">
        @Localizer["Home_Title"]
    </MudText>
    <MudText Typo="Typo.caption" Class="page-subtitle">
        @Localizer["Home_Subtitle"]
    </MudText>

    @if (IsLoading)
    {
        <MudCard Class="light-card">
            <MudCardContent>
                <MudProgressCircular Color="Color.Warning" Indeterminate="true"
                                     Style="display: block; margin: 1rem auto;" />
                <MudText Typo="Typo.body2" Align="Align.Center" Class="phase-next">
                    @Localizer["Loading_Message"]
                </MudText>
            </MudCardContent>
        </MudCard>
    }
    else if (ErrorMessage != null)
    {
        <MudCard Class="light-card-error">
            <MudCardContent>
                <MudText Typo="Typo.body1" Align="Align.Center" Class="phase-error">
                    ⚠️ @ErrorMessage
                </MudText>
            </MudCardContent>
        </MudCard>
    }
    else if (CurrentPhase != null)
    {
        <div class="card-stack">
            <MudCard Class="light-card content-card phase-card"
                     Style="background:#232323; border:1px solid #5a5a5a; box-shadow:0 12px 28px rgba(0,0,0,.35); border-radius:12px;">
                <MudCardContent>
                    <MudText Typo="Typo.h4" Align="Align.Center" Class="phase-title">
                        @CurrentPhase.Icon @Localizer[CurrentPhase.Name]
                    </MudText>
                    <MudText Typo="Typo.body1" Align="Align.Center" Class="phase-description">
                        @Localizer[CurrentPhase.Description]
                    </MudText>

                    <MudDivider Class="divider" />

                    <MudText Typo="Typo.body2" Align="Align.Center" Class="phase-next">
                        @Localizer["NextPhase_Text", Localizer[CurrentPhase.NextPhase]]
                    </MudText>
                </MudCardContent>
            </MudCard>

            <MudCard Class="info-card content-card detail-card mt-3"
                     Style="background:#151515; border:1px solid #2f2f2f; box-shadow:none; border-radius:12px;">
                <MudCardContent>
                    <div class="detail-section">
                        @if (Weather != null)
                        {
                            <div class="weather-summary-line phase-next">
                                @Localizer["Weather_Summary", Weather.Icon, Localizer[Weather.Description], Weather.CloudCover]
                                @if (Weather.IsGoodForPhoto)
                                {
                                    <div class="weather-status weather-good">@Localizer["SuitableForPhoto"]</div>
                                }
                                else
                                {
                                    <div class="weather-status weather-muted">@Localizer["UnsuitableForPhoto"]</div>
                                }
                            </div>
                            <MudText Typo="Typo.caption" Align="Align.Center" Class="phase-location detail-line">
                                @Localizer["Weather_Details", Weather.Temperature.ToString("F0", CultureInfo.InvariantCulture), Weather.WindSpeed.ToString("F0", CultureInfo.InvariantCulture), FormattedVisibility]
                            </MudText>
                        }
                        else if (!string.IsNullOrEmpty(WeatherWarningMessage))
                        {
                            <MudText Typo="Typo.caption" Align="Align.Center" Class="phase-warning">
                                ⚠️ @WeatherWarningMessage
                            </MudText>
                        }

                        <MudText Typo="Typo.caption" Align="Align.Center" Class="phase-location detail-line">
                            @if (Location != null)
                            {
                                @Localizer["Location_Info", LocationName, Location.Lat.ToString("F4", CultureInfo.InvariantCulture), Location.Lng.ToString("F4", CultureInfo.InvariantCulture)]
                            }
                            else
                            {
                                @Localizer["Location_Info", LocationName, "", ""]
                            }
                        </MudText>

                        @if (!string.IsNullOrEmpty(LocationWarningMessage))
                        {
                            <MudText Typo="Typo.caption" Align="Align.Center" Class="phase-warning detail-line">
                                ⚠️ @LocationWarningMessage
                            </MudText>
                        }

                        @if (Location?.Altitude != null)
                        {
                            <MudText Typo="Typo.caption" Align="Align.Center" Class="phase-location detail-line">
                                @string.Format(Localizer["Altitude_Display"], (int)Location.Altitude.Value)
                            </MudText>
                            @if (Location.Altitude.Value > 2000)
                            {
                                <MudText Typo="Typo.caption" Align="Align.Center" Class="phase-warning detail-line">
                                    ⚠️ @Localizer["Altitude_Warning"]
                                </MudText>
                            }
                        }
                    </div>
                </MudCardContent>
            </MudCard>

            <MudCard Class="info-card content-card mt-3"
                     Style="background:#1b1b1b; border:1px solid #4a4a4a; box-shadow:0 10px 24px rgba(0,0,0,.25); border-radius:12px;">
                <MudCardContent>
                    <MudText Typo="Typo.caption" Class="card-kicker">@Localizer["Style_Label"]</MudText>
                    <div class="style-section">
                        <MudRadioGroup T="ShootingStyle" Value="SelectedShootingStyle" ValueChanged="SelectShootingStyle" Class="radio-group">
                            @foreach (var option in StyleOptions)
                            {
                                <MudRadio T="ShootingStyle" Value="option.Value" Color="Color.Warning" Size="Size.Small">
                                    @Localizer[option.LabelKey]
                                </MudRadio>
                            }
                        </MudRadioGroup>
                    </div>
                </MudCardContent>
            </MudCard>

            @if (Advice != null)
            {
                <MudCard Class="info-card content-card mt-3"
                         Style="background:#1b1b1b; border:1px solid #4a4a4a; box-shadow:0 10px 24px rgba(0,0,0,.25); border-radius:12px;">
                    <MudCardContent>
                        <MudText Typo="Typo.caption" Class="card-kicker">@Localizer["Advice_Context_Title"]</MudText>
                        <div class="capture-context-section">
                            <div class="capture-context-control">
                            <MudText Typo="Typo.caption" Class="section-label">@Localizer["Advice_Support_Label"]</MudText>
                            <MudRadioGroup T="CameraSupportMode" Value="SelectedSupportMode" ValueChanged="SelectSupportMode" Class="radio-group compact-radio-group">
                                @foreach (var option in SupportModeOptions)
                                {
                                    <MudRadio T="CameraSupportMode" Value="option.Value" Color="Color.Warning" Size="Size.Small">
                                        @Localizer[option.LabelKey]
                                    </MudRadio>
                                }
                            </MudRadioGroup>
                        </div>

                        <div class="capture-context-control">
                            <MudText Typo="Typo.caption" Class="section-label">@Localizer["Advice_Subject_Label"]</MudText>
                            <MudRadioGroup T="SubjectMotion" Value="SelectedSubjectMotion" ValueChanged="SelectSubjectMotion" Class="radio-group compact-radio-group">
                                @foreach (var option in SubjectMotionOptions)
                                {
                                    <MudRadio T="SubjectMotion" Value="option.Value" Color="Color.Warning" Size="Size.Small">
                                        @Localizer[option.LabelKey]
                                    </MudRadio>
                                }
                            </MudRadioGroup>
                        </div>
                        </div>
                    </MudCardContent>
                </MudCard>

                <MudCard Class="advice-card content-card mt-3"
                         Style="background:#211d17; border:1px solid rgba(245,166,35,.55); box-shadow:0 14px 30px rgba(0,0,0,.35); border-radius:12px;">
                    <MudCardContent>
                        <div class="advice-card-header" Style="position:relative; min-height:3.25rem; padding-right:10rem;">
                            <div class="advice-card-heading">
                                <MudText Typo="Typo.caption" Class="card-kicker">@Localizer["Advice_Card_Title"]</MudText>
                                <MudText Typo="Typo.subtitle2" Class="advice-title">@Advice.Title</MudText>
                                <MudText Typo="Typo.caption" Class="advice-meta">
                                    @Localizer["Advice_Context", Localizer[$"CameraOption_{GetCameraKey(CurrentSettings.Camera)}"], Localizer[$"Experience_{GetExperienceKey(CurrentSettings.Experience)}"], Localizer[$"Style_{GetStyleKey(SelectedShootingStyle)}"]]
                                </MudText>
                            </div>

                            <div class="prompt-action-column" Style="position:absolute; top:0; right:0; align-items:flex-end; display:flex; flex-direction:column; gap:0.35rem;">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Warning"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.ContentCopy"
                                           OnClick="CopyAiPromptAsync">
                                    @Localizer["Advice_CopyPrompt_Button"]
                                </MudButton>
                                @if (!string.IsNullOrEmpty(PromptCopyStatusMessage))
                                {
                                    <div class="prompt-copy-status">@PromptCopyStatusMessage</div>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Advice.FeasibilityWarning))
                        {
                            <div class="advice-section advice-section-warning">
                                <div class="advice-section-title pt-2">@Localizer["Advice_Feasibility_Title"]</div>
                                <ul class="advice-list pl-2">
                                    <li>@Advice.FeasibilityWarning</li>
                                </ul>
                            </div>
                        }

                        <div class="advice-section advice-section-primary">
                            <div class="advice-section-title pt-2">@Localizer["Advice_FirstShot_Title"]</div>
                            <ul class="advice-list pl-2">
                                @foreach (var item in Advice.ExposureSteps)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </div>

                        <div class="advice-section advice-section-muted-panel">
                            <div class="advice-section-title pt-2">@Localizer["Advice_RiskWarnings_Title"]</div>
                            <ul class="advice-list advice-list-muted pl-2">
                                @foreach (var item in Advice.RiskWarnings)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </div>

                        <div class="advice-section advice-section-primary">
                            <div class="advice-section-title pt-2">@Localizer["Advice_Adjustments_Title"]</div>
                            <ul class="advice-list pl-2">
                                @foreach (var item in Advice.AdjustmentSteps)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </div>

                        @if (Advice.FieldSteps.Count > 0)
                        {
                            <div class="advice-section advice-section-primary">
                                <div class="advice-section-title pt-2">@Localizer["Advice_FieldSteps_Title"]</div>
                                <ul class="advice-list pl-2">
                                    @foreach (var item in Advice.FieldSteps)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            }

        </div>
    }

</MudContainer>

@code {
    private static string GetCameraKey(CameraType camera) => camera switch
    {
        CameraType.PhoneBasic => "Phone",
        CameraType.PhonePro => "PhonePro",
        CameraType.MirrorlessAPS => "APS",
        CameraType.FullFrame => "FullFrame",
        CameraType.ActionCam => "ActionCam",
        _ => "PhonePro"
    };

    private static string GetExperienceKey(ExperienceLevel experience) => experience switch
    {
        ExperienceLevel.Beginner => "Beginner",
        ExperienceLevel.Intermediate => "Intermediate",
        ExperienceLevel.Professional => "Professional",
        _ => "Beginner"
    };

    private static string GetStyleKey(ShootingStyle style) => style switch
    {
        ShootingStyle.Landscape => "Landscape",
        ShootingStyle.Urban => "Urban",
        ShootingStyle.Portrait => "Portrait",
        ShootingStyle.NightSky => "NightSky",
        _ => "Landscape"
    };
}