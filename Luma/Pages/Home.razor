@page "/"
@inject Microsoft.Extensions.Localization.IStringLocalizer<Luma.SharedResource> Localizer

<MudContainer MaxWidth="MaxWidth.Small" Class="py-6">

    <MudText Typo="Typo.h5" Class="page-title">
        @Localizer["Home_Title"]
    </MudText>
    <MudText Typo="Typo.caption" Class="page-subtitle">
        @Localizer["Home_Subtitle"]
    </MudText>

    @if (IsLoading)
    {
        <MudCard Class="light-card">
            <MudCardContent>
                <MudProgressCircular Color="Color.Warning" Indeterminate="true"
                                     Style="display: block; margin: 1rem auto;" />
                <MudText Typo="Typo.body2" Align="Align.Center" Class="phase-next">
                    @Localizer["Loading_Message"]
                </MudText>
            </MudCardContent>
        </MudCard>
    }
    else if (ErrorMessage != null)
    {
        <MudCard Class="light-card-error">
            <MudCardContent>
                <MudText Typo="Typo.body1" Align="Align.Center" Class="phase-error">
                    ⚠️ @ErrorMessage
                </MudText>
            </MudCardContent>
        </MudCard>
    }
    else if (CurrentPhase != null)
    {
        <MudCard Class="light-card">
            <MudCardContent>
                <MudText Typo="Typo.h4" Align="Align.Center" Class="phase-title">
                    @CurrentPhase.Icon @CurrentPhase.Name
                </MudText>
                <MudText Typo="Typo.body1" Align="Align.Center" Class="phase-description">
                    @CurrentPhase.Description
                </MudText>

                <MudDivider Class="divider" />

                <MudText Typo="Typo.body2" Align="Align.Center" Class="phase-next">
                    @Localizer["NextPhase_Text", CurrentPhase.NextPhase]
                </MudText>

                <MudDivider Class="divider" />

                @if (Weather != null)
                {
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="phase-next">
                        @Localizer["Weather_Summary", Weather.Icon, Weather.Description, Weather.CloudCover]
                        @if (Weather.IsGoodForPhoto)
                        {
                            <span style="color: var(--mud-palette-warning)"> @Localizer["SuitableForPhoto"]</span>
                        }
                        else
                        {
                            <span style="color: var(--mud-palette-text-secondary)"> @Localizer["UnsuitableForPhoto"]</span>
                        }
                    </MudText>
                    <MudText Typo="Typo.caption" Align="Align.Center" Class="phase-location" Style="margin-top: 4px;">
                        @Localizer["Weather_Details", Weather.Temperature.ToString("F0"), Weather.WindSpeed.ToString("F0"), (Weather.Visibility >= 1000 ? $"{Weather.Visibility / 1000} km" : $"{Weather.Visibility} m")]
                    </MudText>
                }
                
                <MudText Typo="Typo.caption" Align="Align.Center" Class="phase-location">
                    @if (Location != null)
                    {
                        @Localizer["Location_Info", LocationName, Location.Lat.ToString("F4"), Location.Lng.ToString("F4")]
                    }
                    else
                    {
                        @Localizer["Location_Info", LocationName, "", ""]
                    }
                </MudText>
            </MudCardContent>
        </MudCard>
    }

</MudContainer>