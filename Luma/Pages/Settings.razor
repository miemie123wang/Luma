@page "/settings"
<MudContainer MaxWidth="MaxWidth.Small" Class="py-6">

    <MudText Typo="Typo.h5" Class="page-title">
        @Localizer["Settings_Title"]
    </MudText>
    <MudText Typo="Typo.caption" Class="page-subtitle">
        @Localizer["Settings_Subtitle"]
    </MudText>

    @if (!IsLoading)
    {
        <MudText Typo="Typo.caption" Align="Align.Right" Class="phase-location" Style="min-height: 24px; display: block; margin-bottom: 8px;">
            @if (IsSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Warning" Style="vertical-align: middle; margin-right: 6px;" />
                @Localizer["Settings_SaveStatus_Saving"]
            }
            else if (IsSaved)
            {
                <span style="color: var(--mud-palette-warning);">@Localizer["Settings_SaveStatus_Saved"]</span>
            }
            else if (!string.IsNullOrEmpty(SaveErrorMessage))
            {
                <span style="color: var(--mud-palette-error);">@SaveErrorMessage</span>
            }
        </MudText>
    }

    @if (IsLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Warning" Class="d-block mx-auto mt-6" />
    }
    else
    {

    <MudCard Class="light-card">
        <MudCardContent>

            <MudText Typo="Typo.subtitle2" Class="phase-next" Style="margin-bottom: 8px;">@Localizer["Camera_Label"]</MudText>
            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Warning" OverrideStyles="false" Style="flex-wrap: wrap; gap: 8px; margin-bottom: 1.5rem;">
                @foreach (var option in CameraOptions)
                {
                    <MudButton Variant="@(CurrentSettings.Camera == option.Value ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Warning"
                               Size="Size.Small"
                               Disabled="IsSaving"
                               OnClick="@(async () => await UpdateSetting(CurrentSettings.Camera, option.Value, value => CurrentSettings.Camera = value))">
                        @Localizer[option.LabelKey]
                    </MudButton>
                }
            </MudButtonGroup>

            <MudDivider Class="divider" />

            <MudText Typo="Typo.subtitle2" Class="phase-next" Style="margin-bottom: 8px;">@Localizer["Experience_Label"]</MudText>
            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Warning" OverrideStyles="false" Style="flex-wrap: wrap; gap: 8px; margin-bottom: 1.5rem;">
                @foreach (var option in ExperienceOptions)
                {
                    <MudButton Variant="@(CurrentSettings.Experience == option.Value ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Warning"
                               Size="Size.Small"
                               Disabled="IsSaving"
                               OnClick="@(async () => await UpdateSetting(CurrentSettings.Experience, option.Value, value => CurrentSettings.Experience = value))">
                        @Localizer[option.LabelKey]
                    </MudButton>
                }
            </MudButtonGroup>

        </MudCardContent>
    </MudCard>

    }

</MudContainer>