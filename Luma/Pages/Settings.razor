@page "/settings"
<MudContainer MaxWidth="MaxWidth.Small" Class="py-6">

    <MudText Typo="Typo.h5" Class="page-title">
        @Localizer["Settings_Title"]
    </MudText>
    <MudText Typo="Typo.caption" Class="page-subtitle">
        @Localizer["Settings_Subtitle"]
    </MudText>

    @if (IsLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Warning" Class="d-block mx-auto mt-6" />
    }
    else
    {

    <MudCard Class="light-card">
        <MudCardContent>

            <MudText Typo="Typo.subtitle2" Class="phase-next" Style="margin-bottom: 8px;">@Localizer["Camera_Label"]</MudText>
            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Warning" OverrideStyles="false" Style="flex-wrap: wrap; gap: 8px; margin-bottom: 1.5rem;">
                @foreach (var option in CameraOptions)
                {
                    <MudButton Variant="@(CurrentSettings.Camera == option.Value ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Warning"
                               Size="Size.Small"
                               OnClick="@(() => { CurrentSettings.Camera = option.Value; })">
                        @Localizer[option.LabelKey]
                    </MudButton>
                }
            </MudButtonGroup>

            <MudDivider Class="divider" />

            <MudText Typo="Typo.subtitle2" Class="phase-next" Style="margin-bottom: 8px;">@Localizer["Style_Label"]</MudText>
            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Warning" OverrideStyles="false" Style="flex-wrap: wrap; gap: 8px; margin-bottom: 1.5rem;">
                @foreach (var option in StyleOptions)
                {
                    <MudButton Variant="@(CurrentSettings.Style == option.Value ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Warning"
                               Size="Size.Small"
                               OnClick="@(() => { CurrentSettings.Style = option.Value; })">
                        @Localizer[option.LabelKey]
                    </MudButton>
                }
            </MudButtonGroup>

            <MudDivider Class="divider" />

            <MudText Typo="Typo.subtitle2" Class="phase-next" Style="margin-bottom: 8px;">@Localizer["Time_Label"]</MudText>
            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Warning" OverrideStyles="false" Style="flex-wrap: wrap; gap: 8px; margin-bottom: 1.5rem;">
                @foreach (var option in TimeOptions)
                {
                    <MudButton Variant="@(CurrentSettings.TimePreference == option.Value ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Warning"
                               Size="Size.Small"
                               OnClick="@(() => { CurrentSettings.TimePreference = option.Value; })">
                        @Localizer[option.LabelKey]
                    </MudButton>
                }
            </MudButtonGroup>

            <MudDivider Class="divider" />

            <MudText Typo="Typo.subtitle2" Class="phase-next" Style="margin-bottom: 8px;">@Localizer["Experience_Label"]</MudText>
            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Warning" OverrideStyles="false" Style="flex-wrap: wrap; gap: 8px; margin-bottom: 1.5rem;">
                @foreach (var option in ExperienceOptions)
                {
                    <MudButton Variant="@(CurrentSettings.Experience == option.Value ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Warning"
                               Size="Size.Small"
                               OnClick="@(() => { CurrentSettings.Experience = option.Value; })">
                        @Localizer[option.LabelKey]
                    </MudButton>
                }
            </MudButtonGroup>

            <MudButton FullWidth="true"
                       Variant="Variant.Filled"
                       Color="Color.Warning"
                       OnClick="SaveSettings"
                       Style="margin-top: 8px;">
                @(IsSaved ? Localizer["SaveButton_Saved"] : Localizer["SaveButton_Save"])
            </MudButton>

        </MudCardContent>
    </MudCard>

    }

</MudContainer>